{
  "name": "grounded-product",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "dev:mobile": "pnpm --filter @grounded/mobile dev",
    "dev:web": "pnpm --filter @grounded/web dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "node tooling/check-boundaries.mjs && eslint . --max-warnings=0",
    "test": "vitest run",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "turbo": "2.10.8",
    "typescript": "7.0.2",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
